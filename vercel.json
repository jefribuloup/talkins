{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "maxDuration": 60 } },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "headers": { "X-Content-Type-Options": "nosniff" }, "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
